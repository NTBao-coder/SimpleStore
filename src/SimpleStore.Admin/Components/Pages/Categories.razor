@page "/categories"
@inject ICatalogApiClient Catalog

<PageTitle>Categories</PageTitle>

<header class="page-header">
    <div>
        <h1>Categories</h1>
        <p class="page-subtitle">Organize products into browsable groups.</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info" role="alert">@message</div>
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">@(editingId is null ? "Create Category" : "Edit Category")</h5>
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText class="form-control" @bind-Value="form.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="4" @bind-Value="form.Description" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
                    @if (editingId is not null)
                    {
                        <button class="btn btn-outline-secondary" @onclick="ResetForm">Cancel</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Products</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in categories)
                        {
                            <tr>
                                <td>@category.Name</td>
                                <td>@category.Description</td>
                                <td>@category.ProductCount</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Edit(category)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(category.Id)" disabled="@(category.ProductCount > 0)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <small class="text-muted">Delete is disabled when the category still has products.</small>
            </div>
        </div>
    </div>
</div>

<div class="my-3">
    <button class="btn btn-outline-secondary" disabled="@(page <= 1)" @onclick="() => ChangePageAsync(-1)">Previous</button>
    <span>Page @(page) / @Math.Max(1, totalPages)</span>
    <button class="btn btn-outline-secondary" disabled="@(page >= totalPages)" @onclick="() => ChangePageAsync(1)">Next</button>
</div>

@code {
    private List<CategoryDto> categories = [];
    private CategoryDto form = new();
    private int? editingId;
    private string? message;
    private int page = 1;
    private int totalPages;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadAsync();
        }
        catch (HttpRequestException ex) { message = $"Catalog request failed: {ex.Message}"; }
    }
    private async Task LoadAsync()
    {
        var result = await Catalog.GetCategoriesAsync(page: page, pageSize: 20);
        if (page > 1 && result.Items.Count == 0)
        {
            page = Math.Max(1, result.TotalPages);
            result = await Catalog.GetCategoriesAsync(page: page, pageSize: 20);
        }
        categories = result.Items;
        totalPages = result.TotalPages;
    }
    private async Task ChangePageAsync(int delta)
    {
        var previous = page;
        page += delta;
        try { await LoadAsync(); }
        catch (HttpRequestException ex) { page = previous; message = $"Catalog request failed: {ex.Message}"; }
    }
    private void Edit(CategoryDto row)
    {
        editingId = row.Id;
        form = new CategoryDto
        {
            Name = row.Name, Description = row.Description,
        };
        message = null;
    }
    private async Task SaveAsync()
    {
        try
        {
            if (editingId is int id) await Catalog.UpdateCategoryAsync(id, form);
            else await Catalog.CreateCategoryAsync(form);
            message = "Category saved.";
            ResetForm();
            await LoadAsync();
        }
        catch (HttpRequestException ex) { message = $"Catalog request failed: {ex.Message}"; }
    }
    private async Task DeleteAsync(int id)
    {
        try
        {
            await Catalog.DeleteCategoryAsync(id);
            message = "Category deleted.";
            await LoadAsync();
        }
        catch (HttpRequestException ex) { message = $"Catalog request failed: {ex.Message}"; }
    }
    private void ResetForm()
    {
        editingId = null;
        form = new();
    }
}
