@page "/products"
@inject ICatalogApiClient Catalog

<PageTitle>Products</PageTitle>

<header class="page-header">
    <div>
        <h1>Products</h1>
        <p class="page-subtitle">Manage catalog items, pricing, and stock.</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info" role="alert">@message</div>
}

<div class="row g-3">
    <div class="col-xl-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="card-title">@(editingId is null ? "Create Product" : "Edit Product")</h5>

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText class="form-control" @bind-Value="form.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <InputSelect class="form-select" @bind-Value="form.CategoryId">
                        <option value="0">Select category</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="form.Description" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">Price</label>
                        <InputNumber class="form-control" @bind-Value="form.Price" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Stock</label>
                        <InputNumber class="form-control" @bind-Value="form.Stock" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Image URL</label>
                    <InputText class="form-control" @bind-Value="form.ImageUrl" />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveAsync">Save</button>
                    @if (editingId is not null)
                    {
                        <button class="btn btn-outline-secondary" @onclick="ResetForm">Cancel</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card shadow-sm border-0">
            <div class="card-body table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.CategoryName</td>
                                <td>@product.Price.ToString("C")</td>
                                <td>@product.Stock</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => Edit(product)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(product.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="my-3">
    <button class="btn btn-outline-secondary" disabled="@(page <= 1)" @onclick="() => ChangePageAsync(-1)">Previous</button>
    <span>Page @(page) / @Math.Max(1, totalPages)</span>
    <button class="btn btn-outline-secondary" disabled="@(page >= totalPages)" @onclick="() => ChangePageAsync(1)">Next</button>
</div>

@code {
    private List<ProductDto> products = [];
    private ProductDto form = new();
    private int? editingId;
    private string? message;
    private int page = 1;
    private int totalPages;
    private List<CategoryDto> categories = [];
    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = await Catalog.GetAllCategoriesAsync();
            await LoadAsync();
        }
        catch (HttpRequestException ex) { message = $"Catalog request failed: {ex.Message}"; }
    }
    private async Task LoadAsync()
    {
        var result = await Catalog.GetProductsAsync(page: page, pageSize: 20);
        if (page > 1 && result.Items.Count == 0)
        {
            page = Math.Max(1, result.TotalPages);
            result = await Catalog.GetProductsAsync(page: page, pageSize: 20);
        }
        products = result.Items;
        totalPages = result.TotalPages;
    }
    private async Task ChangePageAsync(int delta)
    {
        var previous = page;
        page += delta;
        try { await LoadAsync(); }
        catch (HttpRequestException ex) { page = previous; message = $"Catalog request failed: {ex.Message}"; }
    }
    private void Edit(ProductDto row)
    {
        editingId = row.Id;
        form = new ProductDto
        {
            Name = row.Name, Description = row.Description,
            Price = row.Price, Stock = row.Stock, ImageUrl = row.ImageUrl, CategoryId = row.CategoryId,
        };
        message = null;
    }
    private async Task SaveAsync()
    {
        try
        {
            if (editingId is int id) await Catalog.UpdateProductAsync(id, form);
            else await Catalog.CreateProductAsync(form);
            message = "Product saved.";
            ResetForm();
            await LoadAsync();
        }
        catch (HttpRequestException ex) { message = $"Catalog request failed: {ex.Message}"; }
    }
    private async Task DeleteAsync(int id)
    {
        try
        {
            await Catalog.DeleteProductAsync(id);
            message = "Product deleted.";
            await LoadAsync();
        }
        catch (HttpRequestException ex) { message = $"Catalog request failed: {ex.Message}"; }
    }
    private void ResetForm()
    {
        editingId = null;
        form = new();
    }
}
