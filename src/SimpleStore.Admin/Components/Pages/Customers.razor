@page "/customers"
@inject IIdentityApiClient Identity
@inject OrderDbContext OrderDb

<PageTitle>Customers</PageTitle>

<header class="page-header">
    <div>
        <h1>Customers</h1>
        <p class="page-subtitle">Browse customer accounts and manage access.</p>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-info" role="alert">@message</div>
}

@if (isLoading)
{
    <p>Loading customers...</p>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Orders</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in customers)
                    {
                        <tr>
                            <td>
                                <InputText class="form-control form-control-sm" @bind-Value="customer.FullName" />
                            </td>
                            <td>@customer.Email</td>
                            <td>@customer.PhoneNumber</td>
                            <td>@customer.OrderCount</td>
                            <td>
                                @if (customer.IsLocked)
                                {
                                    <span class="badge text-bg-danger">Locked</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => SaveCustomerAsync(customer)">Save</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleLockAsync(customer)">
                                    @(customer.IsLocked ? "Unlock" : "Lock")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private readonly List<CustomerRow> customers = [];
    private bool isLoading = true;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        customers.Clear();

        var orderCounts = await OrderDb.Orders
            .GroupBy(o => o.UserId)
            .Select(g => new { UserId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.UserId, x => x.Count);

        var users = await Identity.GetUsersAsync();

        foreach (var user in users)
        {
            customers.Add(new CustomerRow
            {
                Id = user.Id,
                FullName = user.FullName,
                Email = user.Email,
                PhoneNumber = user.PhoneNumber ?? string.Empty,
                IsLocked = user.IsLocked,
                OrderCount = orderCounts.GetValueOrDefault(user.Id)
            });
        }

        isLoading = false;
    }

    private async Task SaveCustomerAsync(CustomerRow row)
    {
        await Identity.UpdateUserAsync(row.Id, new UpdateUserRequest(row.FullName.Trim()));
        message = $"Updated {row.Email}.";
    }

    private async Task ToggleLockAsync(CustomerRow row)
    {
        row.IsLocked = !row.IsLocked;
        await Identity.SetLockedAsync(row.Id, row.IsLocked);
        message = row.IsLocked ? $"Locked {row.Email}." : $"Unlocked {row.Email}.";
    }

    private sealed class CustomerRow
    {
        public string Id { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public bool IsLocked { get; set; }
        public int OrderCount { get; set; }
    }
}
